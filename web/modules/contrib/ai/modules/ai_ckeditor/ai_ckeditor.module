<?php

/**
 * @file
 * A module file.
 */

use Drupal\ai_ckeditor\Hook\AiCKEditorHooks;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\ai_ckeditor\PreRender\PreRender;
use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * Implements hook_element_info_alter().
 */
function ai_ckeditor_element_info_alter(array &$info): void {
  if (isset($info['text_format']['#pre_render'])) {
    $info['text_format']['#pre_render'][] = [
      PreRender::class,
      'textFormatPreRender',
    ];
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function ai_ckeditor_module_implements_alter(&$implementations, $hook): void {
  if (isset($implementations['ai_ckeditor'])) {
    $implementation = $implementations['ai_ckeditor'];
    unset($implementations['ai_ckeditor']);
    $implementations['ai_ckeditor'] = $implementation;
  }
}

/**
 * Implements hook_form_alter().
 *
 * Attaches the editing entity's type and id to drupalSettings for any
 * entity form that may render a CKEditor field. The client-side
 * AiDrupalDialog command reads this registry (keyed by form HTML id)
 * to populate the entity context payload sent to the AiRequest
 * controller, which loads the entity server-side (deriving the bundle
 * from it) and stores the result on ChatInput metadata for event
 * subscribers (e.g. ai_context) to consume.
 *
 * This avoids URL parsing entirely, handles nested and AJAX-loaded forms,
 * and works for any entity type that uses a standard form controller.
 */
function ai_ckeditor_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof EntityInterface) {
    return;
  }
  $html_id = $form['#id'] ?? NULL;
  if (!$html_id) {
    return;
  }
  $form['#attached']['drupalSettings']['aiCkeditor']['entityContext'][$html_id] = [
    'entity_type' => $entity->getEntityTypeId(),
    'id' => (string) ($entity->id() ?? ''),
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for system_modules_uninstall_confirm_form.
 */
#[LegacyHook]
function ai_ckeditor_form_system_modules_uninstall_confirm_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(AiCKEditorHooks::class)->formSystemModulesUninstallConfirmFormAlter($form, $form_id, $form_state);
}
