<?php

/**
 * @file
 * Install, update and uninstall functions for the ai module.
 */

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_requirements().
 */
function ai_requirements($phase) {
  $requirements = [];

  // Check that providers are installed and usable.
  if ($phase == 'runtime') {
    $ai_provider = \Drupal::service('ai.provider');
    $warn = TRUE;
    foreach ($ai_provider->getDefinitions() as $provider_id => $provider) {
      if ($ai_provider->createInstance($provider_id)->isUsable()) {
        $warn = FALSE;
        break;
      }
    }
    if ($warn) {
      $requirements['ai_module'] = [
        'title' => t('AI'),
        'value' => t('You need to install and setup one AI Provider before you can use the AI module.'),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
    else {
      $requirements['ai_module'] = [
        'title' => t('AI'),
        'value' => t('Providers installed'),
        'severity' => REQUIREMENT_OK,
      ];
    }

    $requirements += _ai_built_assets_requirements();
  }

  return $requirements;
}

/**
 * Checks that the front-end UI assets shipped by the AI module are built.
 *
 * The MDXEditor and JSON Schema Editor assets are only committed to tagged
 * releases. When using a development branch they must be built locally with
 * `npm run build`. Without them the MDXEditor textarea enhancement and the
 * `ai_json_schema` form element fall back to plain textareas.
 *
 * @return array
 *   Requirement entries keyed by id, ready to merge into hook_requirements().
 */
function _ai_built_assets_requirements(): array {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'ai');
  $assets = [
    'ui/mdxeditor/dist/assets/main.js',
    'ui/json-schema-editor/dist/ai-json-schema.js',
  ];

  $missing = [];
  foreach ($assets as $asset) {
    if (!file_exists($module_path . '/' . $asset)) {
      $missing[] = $asset;
    }
  }

  if (empty($missing)) {
    return [
      'ai_built_assets' => [
        'title' => t('AI built assets'),
        'value' => t('Built JavaScript assets for the AI module are present.'),
        'severity' => REQUIREMENT_OK,
      ],
    ];
  }

  return [
    'ai_built_assets' => [
      'title' => t('AI built assets'),
      'value' => t('Built JavaScript assets for the AI module are missing.'),
      'description' => t('The following built assets are missing: <code>@assets</code>. Run <code>npm ci</code> and <code>npm run build</code> in the <code>ai</code> module folder to generate them.', [
        '@assets' => implode(', ', $missing),
      ]),
      'severity' => REQUIREMENT_WARNING,
    ],
  ];
}

/**
 * Update hook to update the custom models.
 */
function ai_update_10300() {
  $old_config = \Drupal::configFactory()->get('ai_models.settings');
  if ($old_config->get('models')) {
    $models = $old_config->get('models');
    $config = \Drupal::configFactory()->getEditable('ai.settings');
    $config->set('models', $models)->save();
    // Remove the old config.
    \Drupal::configFactory()->getEditable('ai_models.settings')->delete();
  }
}

