<?php

/**
 * @file
 * Chaos Tools Blocks.
 */

use Drupal\Core\Hook\Attribute\ExtensionFileIsConverted;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ctools_block\Hook\CtoolsBlockHooks;

/**
 * Implements hook_plugin_filter_TYPE_alter() for block plugins.
 *
 * @phpstan-ignore attribute.notFound
 */
#[ExtensionFileIsConverted]
#[LegacyHook]
function ctools_block_plugin_filter_block_alter(array &$definitions, array $extra, $consumer) {
  \Drupal::service(CtoolsBlockHooks::class)->pluginFilterBlockAlter($definitions, $extra, $consumer);
}
